# Copia este archivo a .env y usa la misma contraseña en ambas líneas.
POSTGRES_USER=assetops
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE_LOCAL
POSTGRES_DB=assetops
POSTGRES_PORT=5433
DATABASE_URL=postgresql://assetops:CAMBIA_ESTA_CLAVE_LOCAL@127.0.0.1:5433/assetops?schema=public

# Configuración local del login. Genera tu propia clave de firma.
HOST=127.0.0.1
PORT=3000
JWT_SECRET=
ADMIN_CORREO=admin@assetops.test
ADMIN_PASSWORD=

# Configuración SMTP para notificaciones por correo (HU03 y HU06).
# Ejemplo Ethereal (cuenta de prueba gratuita en https://ethereal.email/):
#   SMTP_HOST=smtp.ethereal.email
#   SMTP_PORT=587
#   SMTP_SECURE=false
# Ejemplo Gmail (requiere verificación en 2 pasos y Contraseña de Aplicación):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AssetOps TI <no-reply@assetops.test>"
MAIL_WELCOME_ENABLED=true
SMTP_TEST_TO=
